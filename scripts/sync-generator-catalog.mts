/**
 * Regenerates src/generators/catalog-data.ts from an Ascii-Motion checkout's
 * generator registry so the bundled (headless) catalog matches the app.
 *
 * Usage (requires node_modules installed in the Ascii-Motion checkout):
 *   npx tsx scripts/sync-generator-catalog.mts /path/to/Ascii-Motion
 */
import { execFileSync } from 'node:child_process';
import { writeFileSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const appRoot = resolve(process.argv[2] ?? '../Ascii-Motion');
const here = dirname(fileURLToPath(import.meta.url));
const outFile = resolve(here, '../src/generators/catalog-data.ts');

const generators = await import(pathToFileURL(resolve(appRoot, 'src/registry/generators/index.ts')).href);
const registry = await import(pathToFileURL(resolve(appRoot, 'src/registry/generatorRegistry.ts')).href);
generators.registerAllGenerators();

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const entries = registry.getAllGenerators().map((e: any) => ({
  type: e.type,
  name: e.name,
  description: e.description,
  mode: e.mode,
  phaseProperties: e.phaseProperties ?? [],
  defaultSettings: e.defaultSettings,
  properties: e.propertyDefinitions,
}));

let commit = 'unknown';
try {
  commit = execFileSync('git', ['-C', appRoot, 'rev-parse', '--short', 'HEAD']).toString().trim();
} catch {
  // not a git checkout
}

const body = `/**
 * GENERATED by scripts/sync-generator-catalog.mts from Ascii-Motion@${commit}.
 * Do not edit by hand — re-run the script when the app's generator registry changes.
 */
import type { GeneratorCatalogEntry } from './catalog-types.js';

export const GENERATOR_CATALOG_SOURCE_COMMIT = '${commit}';

export const BUNDLED_GENERATOR_CATALOG: GeneratorCatalogEntry[] = ${JSON.stringify(entries, null, 2)};
`;
writeFileSync(outFile, body);
console.log(`Wrote ${entries.length} generators to ${outFile}`);
